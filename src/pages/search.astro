---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search.astro';
---
<Base title="Search" description="Full-text search across every lesson." eyebrow="search">
  <div style="padding:44px 0 0;max-width:74ch">
    <h1 style="font-size:clamp(1.9rem,4.4vw,2.6rem);margin:0 0 12px">Search</h1>
    <p style="color:var(--color-ink-soft);font-size:1.04rem;line-height:1.65;margin:0 0 28px">
      Indexed at build time by Pagefind, which downloads only the fragments a query needs
      rather than the whole index up front.
    </p>
    <Search className="pagefind-ui" />
  </div>
</Base>

<style is:global>
  /* Pagefind's searchbox renders into the light DOM with `pf-*` classes and
     exposes its palette as custom properties. It ships a light theme by
     default, which is wrong here — this site is dark-only. */
  pagefind-searchbox {
    --pf-font: var(--font-sans);
    --pf-background: color-mix(in oklab, var(--color-surface) 92%, transparent);
    --pf-border: var(--color-rule);
    --pf-border-focus: var(--color-cyan);
    --pf-border-radius: 2px;
    --pf-hover: color-mix(in oklab, var(--color-cyan) 12%, transparent);
    --pf-mark: color-mix(in oklab, var(--color-magenta) 30%, transparent);
    --pf-text: var(--color-ink);
    --pf-text-secondary: var(--color-ink-soft);
    --pf-text-muted: var(--color-ink-faint);
    --pf-skeleton: var(--color-raised);
    --pf-skeleton-shine: var(--color-rule-bright);
    --pf-outline-focus: var(--color-cyan);
    --pf-outline-width: 2px;
    --pf-shadow-sm: none;
    --pf-shadow-md: 0 8px 30px -10px rgba(0, 0, 0, 0.8);
    --pf-shadow-lg: 0 16px 50px -12px rgba(0, 0, 0, 0.85);
    --pf-modal-backdrop: rgba(7, 6, 11, 0.8);
    --pf-searchbox-max-width: 100%;
    --pf-input-font-size: 0.95rem;
    display: block;
  }

  .pf-searchbox-input {
    background: var(--glass) !important;
    backdrop-filter: var(--glass-blur);
    color: var(--color-ink) !important;
    font-family: var(--font-mono) !important;
    border-color: var(--color-rule) !important;
  }
  .pf-searchbox-input::placeholder { color: var(--color-ink-ghost) !important; }

  .pf-searchbox-dropdown {
    background: color-mix(in oklab, var(--color-abyss) 96%, transparent) !important;
    border-color: var(--color-rule) !important;
    backdrop-filter: var(--glass-blur);
  }

  .pf-searchbox-result-title { color: var(--color-ink) !important; font-family: var(--font-display); }
  .pf-searchbox-result-excerpt { color: var(--color-ink-faint) !important; }
  .pf-searchbox-result[aria-selected='true'],
  .pf-searchbox-result:hover {
    background: color-mix(in oklab, var(--color-cyan) 12%, transparent) !important;
    border-color: var(--color-cyan) !important;
  }
  .pf-searchbox-result mark,
  .pf-searchbox-result-excerpt mark {
    background: color-mix(in oklab, var(--color-magenta) 28%, transparent);
    color: var(--color-ink);
  }

  .pf-searchbox-footer,
  .pf-searchbox-status { color: var(--color-ink-ghost) !important; }
  .pf-searchbox-footer-key,
  .pf-trigger-key {
    background: var(--color-raised) !important;
    border-color: var(--color-rule) !important;
    color: var(--color-ink-faint) !important;
  }
  .pf-skeleton, .pf-skeleton-title, .pf-skeleton-excerpt {
    background: var(--color-raised) !important;
  }
</style>
