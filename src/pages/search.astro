---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search.astro';
---
<Base title="Search" description="Full-text search across every lesson." eyebrow="search">
  <div style="padding:44px 0 0;max-width:74ch">
    <h1 style="font-size:clamp(1.9rem,4.4vw,2.6rem);margin:0 0 12px">Search</h1>
    <p style="color:var(--color-ink-soft);font-size:1.04rem;line-height:1.65;margin:0 0 28px">
      Indexed at build time by Pagefind, which downloads only the fragments a query needs
      rather than the whole index up front.
    </p>
    <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 24 }} />
  </div>
</Base>

<style is:global>
  /* Pagefind ships its own UI; restyle it into the HUD language. */
  .pagefind-ui {
    --pagefind-ui-primary: var(--color-cyan);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--color-rule);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--font-sans);
  }
  .pagefind-ui__search-input {
    background: var(--glass) !important;
    backdrop-filter: var(--glass-blur);
    color: var(--color-ink) !important;
    font-family: var(--font-mono) !important;
    font-size: 0.95rem !important;
  }
  .pagefind-ui__result {
    border-top: 1px solid var(--color-rule) !important;
    padding: 14px 0 !important;
  }
  .pagefind-ui__result-title a { color: var(--color-cyan) !important; font-family: var(--font-display); }
  .pagefind-ui__result-excerpt { color: var(--color-ink-faint) !important; font-size: 0.9rem !important; }
  .pagefind-ui__result-excerpt mark {
    background: color-mix(in oklab, var(--color-magenta) 26%, transparent);
    color: var(--color-ink);
  }
  .pagefind-ui__message { color: var(--color-ink-faint) !important; font-family: var(--font-mono); font-size: 0.8rem !important; }
</style>
