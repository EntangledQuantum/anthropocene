---
import Base from '../../../layouts/Base.astro';
import PathJourney from '../../../components/chrome/PathJourney.tsx';
import { buildGraph } from '../../../lib/graph/graph.ts';

export async function getStaticPaths() {
  const graph = await buildGraph();
  return graph.paths.map((path) => ({ params: { path: path.id }, props: { path } }));
}

const { path } = Astro.props;
const hours = (path.minutes / 60).toFixed(1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Serialised for the client island; keep it to what the journey actually renders.
const chapters = path.chapters.map((c) => ({
  id: c.id,
  title: c.title,
  question: c.question,
  url: c.url,
  lessons: c.lessons.map((l) => ({
    id: l.id, title: l.title, blurb: l.blurb, url: l.url,
    minutes: l.minutes, tier: l.tier, status: l.status,
  })),
}));
---
<Base title={path.title} description={path.blurb} crumbs={[{ label: 'Paths', href: `${base}/learn/` }, { label: path.title }]}>
  <div style="padding-top:20px;max-width:52rem">
    <header style="margin-bottom:44px">
      <h1 style="font-size:clamp(2.4rem,5vw,3.4rem);margin:0 0 16px">{path.title}</h1>
      <p style="color:var(--color-ink-soft);font-size:1.15rem;line-height:1.7;margin:0 0 18px;max-width:42rem">{path.blurb}</p>
      <div class="meta">
        <span>{path.chapters.length} chapters</span>
        <span>{path.lessons.length} lessons written</span>
        <span>≈ {hours} h</span>
      </div>
    </header>

    <!-- client:only — the journey reflects local progress, which has no server equivalent -->
    <PathJourney client:only="react" chapters={chapters} accent={path.accent} />
  </div>
</Base>
