---
import Base from '../../../layouts/Base.astro';
import PathJourney from '../../../components/chrome/PathJourney.tsx';
import { buildGraph } from '../../../lib/graph/graph.ts';

export async function getStaticPaths() {
  const graph = await buildGraph();
  return graph.paths.map((path) => ({ params: { path: path.id }, props: { path } }));
}

const { path } = Astro.props;
const hours = (path.minutes / 60).toFixed(1);

// Serialised for the client island; keep it to what the journey actually renders.
const chapters = path.chapters.map((c) => ({
  id: c.id,
  title: c.title,
  question: c.question,
  url: c.url,
  lessons: c.lessons.map((l) => ({
    id: l.id, title: l.title, blurb: l.blurb, url: l.url,
    minutes: l.minutes, tier: l.tier, status: l.status,
  })),
}));
---
<Base title={path.title} description={path.blurb} eyebrow="learning path">
  <div style="padding:56px 0 0">
    <header style="max-width:64ch;margin-bottom:52px">
      <span class="hud-label" style={`color:var(--color-${path.accent})`}>◆ {path.subtitle}</span>
      <h1 style="font-size:clamp(2.2rem,5vw,3.2rem);margin:14px 0 20px" class="text-glow-magenta">{path.title}</h1>
      <p style="color:var(--color-ink-soft);font-size:1.16rem;line-height:1.7;margin:0 0 24px">{path.blurb}</p>
      <div style="display:flex;gap:26px;flex-wrap:wrap">
        <span class="hud-label">{path.chapters.length} chapters</span>
        <span class="hud-label">{path.lessons.length} lessons</span>
        <span class="hud-label">≈ {hours} h</span>
      </div>
    </header>

    <!-- client:only — the journey reflects local progress, which has no server equivalent -->
    <PathJourney client:only="react" chapters={chapters} accent={path.accent} />
  </div>
</Base>
