---
import { render } from 'astro:content';
import LessonLayout from '../../../../layouts/Lesson.astro';
import Predict from '../../../../components/widgets/Predict.astro';
import Tune from '../../../../components/widgets/Tune.astro';
import Recall from '../../../../components/widgets/Recall.astro';
import Tier from '../../../../components/widgets/Tier.astro';
import SketchCurve from '../../../../components/widgets/SketchCurve.astro';
import RankOrder from '../../../../components/widgets/RankOrder.astro';
import Classify from '../../../../components/widgets/Classify.astro';
import Estimate from '../../../../components/widgets/Estimate.astro';
import StabilityExplorer from '../../../../components/widgets/StabilityExplorer.astro';
import PhaseFlow from '../../../../components/widgets/PhaseFlow.astro';
import Plot from '../../../../components/widgets/Plot.astro';
import SolverLab from '../../../../components/widgets/SolverLab.astro';
import ConvergenceLab from '../../../../components/widgets/ConvergenceLab.astro';
import DerivativeLab from '../../../../components/widgets/DerivativeLab.astro';
import FloatLab from '../../../../components/widgets/FloatLab.astro';
import CancellationLab from '../../../../components/widgets/CancellationLab.astro';
import RichardsonTableau from '../../../../components/widgets/RichardsonTableau.astro';
import AdaptiveLab from '../../../../components/widgets/AdaptiveLab.astro';
import SpectralLab from '../../../../components/widgets/SpectralLab.astro';
import LJGas from '../../../../components/widgets/LJGas.astro';
import InverseLab from '../../../../components/widgets/InverseLab.astro';
import PinnLab from '../../../../components/widgets/PinnLab.astro';
import ManifoldLab from '../../../../components/widgets/ManifoldLab.astro';
import ContinuumLab from '../../../../components/widgets/ContinuumLab.astro';
import DependenceLab from '../../../../components/widgets/DependenceLab.astro';
import CflLab from '../../../../components/widgets/CflLab.astro';
import GhostLab from '../../../../components/widgets/GhostLab.astro';
import FemLab from '../../../../components/widgets/FemLab.astro';
import ProjectionLab from '../../../../components/widgets/ProjectionLab.astro';
import MpmLab from '../../../../components/widgets/MpmLab.astro';
import FvmLab from '../../../../components/widgets/FvmLab.astro';
import OperatorLab from '../../../../components/widgets/OperatorLab.astro';
import JacobiLab from '../../../../components/widgets/JacobiLab.astro';
import KrylovLab from '../../../../components/widgets/KrylovLab.astro';
import PreconditionerLab from '../../../../components/widgets/PreconditionerLab.astro';
import TwoGridLab from '../../../../components/widgets/TwoGridLab.astro';
import QrLab from '../../../../components/widgets/QrLab.astro';
import NewtonLab from '../../../../components/widgets/NewtonLab.astro';

/** The authoring vocabulary: every lesson may use these with no import.
 *  Adding a widget here is what makes it available to authors — see AGENTS.md. */
const lessonComponents = {
  Predict, Tune, SketchCurve, RankOrder, Classify, Estimate, Recall, Tier,
  Plot, SolverLab, ConvergenceLab, DerivativeLab, FloatLab, CancellationLab,
  StabilityExplorer, PhaseFlow, RichardsonTableau, AdaptiveLab, SpectralLab, LJGas,
  InverseLab, PinnLab, ManifoldLab, ContinuumLab, DependenceLab, CflLab,
  GhostLab, FemLab, ProjectionLab, MpmLab, FvmLab, OperatorLab, JacobiLab, KrylovLab,
  PreconditionerLab, TwoGridLab, QrLab, NewtonLab,
};
import { buildGraph, prerequisitesOf, unlockedBy } from '../../../../lib/graph/graph.ts';

export async function getStaticPaths() {
  const graph = await buildGraph();

  return [...graph.lessons.values()].map((lesson) => {
    const path = graph.paths.find((p) => p.id === lesson.pathId)!;
    const chapter = path.chapters.find((c) => c.id === lesson.chapterId)!;

    // Previous/next follow the CHAPTER's reading order, not the global topo
    // order — inside a chapter the author's sequence is the intended one.
    const siblings = chapter.lessons;
    const i = siblings.findIndex((l) => l.id === lesson.id);

    return {
      params: { path: lesson.pathId, chapter: chapter.slug, lesson: lesson.slug },
      props: {
        lesson,
        path,
        chapter,
        prereqs: prerequisitesOf(graph, lesson.id),
        unlocks: unlockedBy(graph, lesson.id),
        prev: siblings[i - 1] ?? null,
        next: siblings[i + 1] ?? null,
      },
    };
  });
}

const { lesson, path, chapter, prereqs, unlocks, prev, next } = Astro.props;
const { Content } = await render(lesson.entry);
---
<LessonLayout
  lesson={lesson}
  path={path}
  chapter={chapter}
  prereqs={prereqs}
  unlocks={unlocks}
  prev={prev}
  next={next}
>
  <Content components={lessonComponents} />
</LessonLayout>
