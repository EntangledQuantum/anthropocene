---
import { render } from 'astro:content';
import LessonLayout from '../../../../layouts/Lesson.astro';
/** The authoring vocabulary: every lesson may use these with no import.
 *
 *  Every `.astro` file in `components/widgets/` is registered under its own
 *  filename, so **adding a widget is adding a file** — no edit here, and no
 *  merge conflict when several authors add widgets at once. The wrappers are
 *  what carry the client directive; React components cannot. See AGENTS.md §8.
 */
const widgetModules = import.meta.glob<{ default: unknown }>(
  "../../../../components/widgets/*.astro",
  { eager: true },
);

const lessonComponents = Object.fromEntries(
  Object.entries(widgetModules).map(([file, mod]) => [
    file.slice(file.lastIndexOf("/") + 1, -".astro".length),
    mod.default,
  ]),
);

import { buildGraph, prerequisitesOf, unlockedBy } from '../../../../lib/graph/graph.ts';

export async function getStaticPaths() {
  const graph = await buildGraph();

  return [...graph.lessons.values()].map((lesson) => {
    const path = graph.paths.find((p) => p.id === lesson.pathId)!;
    const chapter = path.chapters.find((c) => c.id === lesson.chapterId)!;

    // Previous/next follow the CHAPTER's reading order, not the global topo
    // order — inside a chapter the author's sequence is the intended one.
    const siblings = chapter.lessons;
    const i = siblings.findIndex((l) => l.id === lesson.id);

    return {
      params: { path: lesson.pathId, chapter: chapter.slug, lesson: lesson.slug },
      props: {
        lesson,
        path,
        chapter,
        prereqs: prerequisitesOf(graph, lesson.id),
        unlocks: unlockedBy(graph, lesson.id),
        prev: siblings[i - 1] ?? null,
        next: siblings[i + 1] ?? null,
      },
    };
  });
}

const { lesson, path, chapter, prereqs, unlocks, prev, next } = Astro.props;
const { Content } = await render(lesson.entry);
---
<LessonLayout
  lesson={lesson}
  path={path}
  chapter={chapter}
  prereqs={prereqs}
  unlocks={unlocks}
  prev={prev}
  next={next}
>
  <Content components={lessonComponents} />
</LessonLayout>
