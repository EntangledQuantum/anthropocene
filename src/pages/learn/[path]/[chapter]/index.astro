---
import Base from '../../../../layouts/Base.astro';
import { buildGraph } from '../../../../lib/graph/graph.ts';

export async function getStaticPaths() {
  const graph = await buildGraph();
  return graph.paths.flatMap((path) =>
    path.chapters.map((chapter) => ({
      params: { path: path.id, chapter: chapter.slug },
      props: { path, chapter },
    })),
  );
}

const { path, chapter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chapterNo = path.chapters.findIndex((c) => c.id === chapter.id) + 1;
const TIER: Record<string, string> = {
  foundation: 'Foundation', core: 'Core', advanced: 'Advanced', frontier: 'Frontier',
};
---
<Base
  title={chapter.title}
  description={chapter.blurb}
  crumbs={[{ label: 'Paths', href: `${base}/learn/` }, { label: path.title, href: path.url }, { label: `Chapter ${chapterNo}` }]}
>
  <div style="padding-top:20px;max-width:52rem">
    <span class="eyebrow">Chapter {chapterNo}</span>
    <h1 style="font-size:clamp(2.2rem,4.6vw,3.1rem);margin:10px 0 14px">{chapter.title}</h1>
    {chapter.question && (
      <p style="font-family:var(--font-display);font-style:italic;font-size:1.4rem;color:var(--color-ink-soft);line-height:1.45;margin:0 0 14px">
        {chapter.question}
      </p>
    )}
    <p style="color:var(--color-ink-faint);font-size:1.05rem;line-height:1.65;margin:0 0 36px;max-width:42rem">{chapter.blurb}</p>

    {chapter.lessons.length === 0 ? (
      <p style="color:var(--color-ink-faint)">No lessons written for this chapter yet.</p>
    ) : (
      <ol class="toc">
        {chapter.lessons.map((l, i) => (
          <li>
            <a href={l.url} class="toc-row" style="padding:18px 4px">
              <span class="toc-num">{i + 1}.</span>
              <span>
                <span class="toc-title" style="font-family:var(--font-display);font-size:1.4rem">{l.title}</span>
                <span class="toc-sub" style="margin-top:4px">{l.blurb}</span>
              </span>
              <span class="toc-side">{TIER[l.tier] ?? l.tier} · {l.minutes} min</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
