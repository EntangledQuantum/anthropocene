---
import Base from '../layouts/Base.astro';
import { buildGraph } from '../lib/graph/graph.ts';

const graph = await buildGraph();
const live = [...graph.lessons.values()].filter((l) => l.status === 'live');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstLesson = graph.paths[0]?.chapters.flatMap((c) => c.lessons)[0];
---
<Base title="Learn physics by doing it" description="Free, interactive lessons where the visualization is the explanation.">
  <div class="page-grid" style="padding-top:72px">
    <div>
      <section style="max-width:40rem;margin-bottom:72px">
        <h1 style="font-size:clamp(2.6rem,6vw,4rem);line-height:1.04;margin:0 0 22px">
          Learn physics by <em style="font-style:italic">doing</em> it.
        </h1>
        <p style="font-size:1.22rem;line-height:1.65;color:var(--color-ink-soft);margin:0 0 30px">
          Each lesson puts you inside the problem. Predict what a system will do, sketch the
          curve you expect, then watch the real simulation land on your guess.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          {firstLesson && <a href={firstLesson.url} class="btn-primary">Start the first lesson →</a>}
          <a href={`${base}/learn/`} class="btn-quiet">Browse all paths</a>
        </div>
      </section>

      <section id="paths">
        <h2 style="font-size:1.9rem;margin:0 0 6px">Paths</h2>
        <p style="margin:0 0 22px;color:var(--color-ink-faint);font-size:15px">
          {graph.paths.length} paths · {live.length} lessons · {graph.concepts.size} concepts
        </p>

        <ol class="toc">
          {graph.paths.map((p, i) => {
            const written = p.chapters.filter((c) => c.lessons.length > 0);
            return (
              <li>
                <a href={p.url} class="toc-row">
                  <span class="toc-num">{i + 1}.</span>
                  <span>
                    <span class="toc-title" style="font-family:var(--font-display);font-size:1.45rem">{p.title}</span>
                    <span class="toc-sub">{p.subtitle.charAt(0).toUpperCase() + p.subtitle.slice(1)}</span>
                  </span>
                  <span class="toc-side">{p.lessons.length} lessons</span>
                </a>
                <ul class="lesson-list">
                  {written.slice(0, 5).map((c) => (
                    <li>
                      <a href={c.lessons[0].url}>
                        <span>{c.title}</span>
                        <span style="margin-left:auto;font-size:13.5px;color:var(--color-ink-ghost)">
                          {c.lessons.length} {c.lessons.length === 1 ? 'lesson' : 'lessons'}
                        </span>
                      </a>
                    </li>
                  ))}
                  {written.length > 5 && (
                    <li><a href={p.url} style="color:var(--color-ink-faint)">+ {written.length - 5} more chapters</a></li>
                  )}
                </ul>
              </li>
            );
          })}
        </ol>
      </section>
    </div>

    <aside class="page-aside" style="top:96px">
      <div class="aside-block">
        <span class="aside-title">How lessons work</span>
        <ol class="side-list" style="color:var(--color-ink-faint)">
          <li style="padding:5px 0"><strong style="color:var(--color-ink);font-weight:600">Predict first.</strong> You commit to an answer before the simulation runs.</li>
          <li style="padding:5px 0"><strong style="color:var(--color-ink);font-weight:600">Draw, don't type.</strong> You sketch, rank and sort. You never write code.</li>
          <li style="padding:5px 0"><strong style="color:var(--color-ink);font-weight:600">Remember it.</strong> Recall cards come back on a spaced schedule.</li>
        </ol>
      </div>
      <div class="aside-block">
        <ul class="side-list">
          <li><a href={`${base}/review/`}><span class="n">↺</span><span>Review queue</span></a></li>
          <li><a href={`${base}/graph/`}><span class="n">◌</span><span>Concept map</span></a></li>
          <li><a href="https://github.com/EntangledQuantum/anthropocene"><span class="n">↗</span><span>Source on GitHub</span></a></li>
        </ul>
      </div>
      <div class="aside-block" style="font-size:13.5px;color:var(--color-ink-faint);line-height:1.6">
        No account. Progress, XP and review cards stay in your browser.
      </div>
    </aside>
  </div>
</Base>
