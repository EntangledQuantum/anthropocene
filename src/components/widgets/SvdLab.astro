---
// Wrapper so lessons can write <SvdLab /> with no import and no client
// directive: MDX components supplied through the `components` prop cannot
// carry client:* directives themselves, so the directive lives here.
import Island, { type SvdLabProps } from '../viz/SvdLab.tsx';

type Props = Omit<SvdLabProps, 'children'>;
const props = Astro.props as Props;
---
<Island client:visible {...props} />
