---
// `front` is a named slot rather than a prop: a prompt often wants inline math
// or code, and JSX cannot cross the island boundary as a serialised prop.
import Island from '../learn/Recall.tsx';

interface Props { id: string; concept?: string }
const props = Astro.props;
---
<Island client:visible {...props}>
  <slot name="front" slot="front" />
  <slot />
</Island>
