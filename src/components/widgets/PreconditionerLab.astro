---
// Wrapper so lessons can write <PreconditionerLab /> with no import and no client
// directive: MDX components supplied through the `components` prop cannot
// carry client:* directives themselves, so the directive lives here.
import Island, { type PreconditionerLabProps } from '../viz/PreconditionerLab.tsx';

type Props = Omit<PreconditionerLabProps, 'children'>;
const props = Astro.props as Props;
---
<Island client:visible {...props} />
