---
import Base from './Base.astro';
import LessonRuntime from '../components/chrome/LessonRuntime.tsx';
import type { LessonNode, PathNode, ChapterNode } from '../lib/graph/graph.ts';

interface Props {
  lesson: LessonNode;
  path: PathNode;
  chapter: ChapterNode;
  prereqs: LessonNode[];
  next: LessonNode | null;
  prev: LessonNode | null;
  unlocks: LessonNode[];
}

const { lesson, path, chapter, prereqs, next, prev, unlocks } = Astro.props;
const TIER: Record<string, string> = {
  foundation: 'Foundation', core: 'Core', advanced: 'Advanced', frontier: 'Frontier',
};
const chapterNo = path.chapters.findIndex((c) => c.id === chapter.id) + 1;

// When the chapter runs out, point at the next written lesson in the path so
// the reader is never left at a dead end.
const inPath = path.chapters.flatMap((c) => c.lessons);
const nextInPath = next ?? inPath[inPath.findIndex((l) => l.id === lesson.id) + 1] ?? null;
---
<Base
  title={lesson.title}
  description={lesson.blurb}
  crumbs={[
    { label: path.title, href: path.url },
    { label: `${chapterNo}. ${chapter.title}`, href: chapter.url },
  ]}
>
  <div class="page-grid" style="padding-top:28px">
    <article>
      <header style="margin-bottom:40px;max-width:var(--measure)">
        <h1 style="font-size:clamp(2.3rem,4.6vw,3.2rem);margin:0 0 14px">{lesson.title}</h1>
        <p style="color:var(--color-ink-soft);font-size:1.2rem;line-height:1.6;margin:0 0 18px">
          {lesson.blurb}
        </p>
        <div class="meta">
          <span>{TIER[lesson.tier] ?? lesson.tier}</span>
          <span>{lesson.minutes} min</span>
          {lesson.runtime === 'python' && <span>Runs Python in the browser</span>}
          {lesson.status === 'draft' && <span style="color:var(--sig-warn)">Draft</span>}
        </div>
      </header>

      <div class="prose-anth" style="margin-bottom:56px">
        <slot />
      </div>

      <LessonRuntime
        client:only="react"
        lessonId={lesson.id}
        tier={lesson.tier}
        title={lesson.title}
        widgets={lesson.widgets}
        unlocks={unlocks.map((u) => ({ title: u.title, url: u.url, blurb: u.blurb }))}
      />

      <nav style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:40px 0 0">
        {prev ? (
          <a href={prev.url} class="hud" style="padding:16px 18px;text-decoration:none;display:block">
            <span style="display:block;font-size:13.5px;color:var(--color-ink-faint);margin-bottom:4px">← Previous</span>
            <span style="color:var(--color-ink);font-weight:500">{prev.title}</span>
          </a>
        ) : <span />}
        {nextInPath ? (
          <a href={nextInPath.url} class="hud" style="padding:16px 18px;text-decoration:none;display:block;text-align:right">
            <span style="display:block;font-size:13.5px;color:var(--color-accent);margin-bottom:4px">Next →</span>
            <span style="color:var(--color-ink);font-weight:500">{nextInPath.title}</span>
          </a>
        ) : <span />}
      </nav>
    </article>

    <aside class="page-aside" aria-label="Lesson navigation">
      <div class="aside-block">
        <span class="aside-title">Chapter {chapterNo} · {chapter.title}</span>
        <ol class="side-list">
          {chapter.lessons.map((l, i) => (
            <li>
              <a href={l.url} aria-current={l.id === lesson.id ? 'page' : undefined}>
                <span class="n">{i + 1}</span><span>{l.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      {prereqs.length > 0 && (
        <div class="aside-block">
          <span class="aside-title">Builds on</span>
          <ul class="side-list">
            {prereqs.map((p) => (
              <li><a href={p.url}><span class="n">↳</span><span>{p.title}</span></a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="aside-block">
        <a href={path.url} style="font-size:14px;color:var(--color-ink-faint);text-decoration:none">
          ← All of {path.title}
        </a>
      </div>
    </aside>
  </div>
</Base>
