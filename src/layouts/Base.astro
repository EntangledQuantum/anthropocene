---
import '../styles/global.css';
import XpRail from '../components/chrome/XpRail.tsx';
import XpToasts from '../components/chrome/XpToasts.tsx';
import CommandPalette from '../components/chrome/CommandPalette.tsx';

export interface Crumb { label: string; href?: string }

interface Props {
  title: string;
  description?: string;
  /** Breadcrumb trail rendered above the page content. */
  crumbs?: Crumb[];
  /** @deprecated kept so older pages still compile; ignored. */
  eyebrow?: string;
  wide?: boolean;
}

const { title, description, crumbs = [], wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: `${base}/learn/`, label: 'Paths', match: `${base}/learn` },
  { href: `${base}/review/`, label: 'Review', match: `${base}/review` },
  { href: `${base}/graph/`, label: 'Concept map', match: `${base}/graph` },
];
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · anthropocene</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div style="position:relative;z-index:1;display:flex;flex-direction:column;min-height:100dvh">
      <header class="site-header">
        <div class="shell" style={wide ? 'max-width:1400px' : ''}>
          <a href={`${base}/`} class="brand" aria-label="anthropocene — home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">anthropocene</span>
          </a>

          <nav class="site-nav" aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={here.startsWith(item.match) ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>

          <button type="button" id="palette-trigger" class="search-trigger" aria-label="Search lessons and concepts">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
              <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span class="label">Search</span>
            <kbd>⌘K</kbd>
          </button>

          <div class="xp-slot" style="flex-shrink:0">
            <!-- client:only — this reads OPFS, which has no server equivalent. -->
            <XpRail client:only="react" />
          </div>
        </div>
      </header>

      <main class="shell" style={`flex:1;${wide ? 'max-width:1400px;' : ''}`}>
        {crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb" style="padding-top:28px">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )}
        <slot />
      </main>

      <XpToasts client:only="react" />
      <CommandPalette client:only="react" />

      <script is:inline>
        // The palette is a React island; the trigger lives in static markup,
        // so they meet on a custom event rather than through props.
        document.getElementById('palette-trigger')?.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('anthropocene:palette'));
        });
      </script>

      <footer class="site-footer">
        <div class="shell">
          <span>Free and open source. Your progress stays in your browser.</span>
          <a href="https://github.com/EntangledQuantum/anthropocene">Source on GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>
